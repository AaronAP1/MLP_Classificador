# ============================================================================
# DATOS SENSIBLES (NO VERSIONAR)
# ============================================================================
data/raw/*.csv
data/raw/*.xlsx
data/processed/
data/samples/*.csv

# Mantener estructura pero no datos
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/samples/.gitkeep

# ============================================================================
# RESULTADOS Y EXPERIMENTOS
# ============================================================================
results/
!results/.gitkeep

# Checkpoints de modelos
*.pt
*.pth
*.pkl
*.joblib

# Logs
*.log
logs/

