{
  "data": {
    "raw_csv": "data/raw/jovenes.csv",
    "test_size": 0.15,
    "val_size": 0.15,
    "random_state": 42
  },
  "etl": {
    "cat_cols": ["P505","P506","P507","P508","P509","P201","P203","P206","P207","P208","P311","P315_1","P315_2","P315_3","P315_4","P315_5","P315_6"],
    "num_cols": ["FACTORFINAL_HOGAR","P210_A","P210_M","P310_N","P310_A","P409"],
    "target_col": "habito_lectura_completo"
  },
  "model": {
    "hidden_dims": [128, 64, 32],
    "attn_dim": 16,
    "dropout_p": 0.4,
    "batch_size": 64,
    "lr": 0.0005,
    "epochs": 100
  },
  "outputs": {
    "model_dir": "outputs/models",
    "plots_dir": "outputs/plots"
  },
  "training": {
    "early_stopping_patience": 15,
    "target_accuracy": 0.85,
    "validation_split_strategy": "stratified"
  }
}
