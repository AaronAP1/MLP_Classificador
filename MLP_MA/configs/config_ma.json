{
  "data": {
    "raw_csv": "data/raw/jovenes.csv",
    "test_size": 0.15,
    "val_size": 0.15,
    "random_state": 42,
    "save_splits": true
  },
  "etl": {
    "cat_cols": ["P505","P506","P507","P508","P509","P201","P203","P206","P207","P208","P311","P315_1","P315_2","P315_3","P315_4","P315_5","P315_6"],
  "num_cols": ["FACTORFINAL_HOGAR","P210_A","P210_M","P310_N","P310_A"],
    "target_col": "habito_lectura_completo"
  },
  "model": {
    "hidden_dims": [256, 128, 64, 32],
    "attn_dim": 32,
    "dropout_p": 0.3,
    "batch_size": 128,
    "lr": 0.001,
    "epochs": 200,
    "amp": true,
    "use_weighted_sampler": false
  },
  "outputs": {
    "model_dir": "outputs/models",
    "plots_dir": "outputs/plots"
  }
}
